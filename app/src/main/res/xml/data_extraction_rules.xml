<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ backup rules. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="." />
        <include domain="database" path="atlas_reader.db" />
        <include domain="database" path="atlas_reader.db-wal" />
        <include domain="database" path="atlas_reader.db-shm" />
        <exclude domain="file" path="cache" />
        <exclude domain="file" path="covers" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="atlas_reader.db" />
        <include domain="database" path="atlas_reader.db-wal" />
        <include domain="database" path="atlas_reader.db-shm" />
        <include domain="file" path="covers" />
    </device-transfer>
</data-extraction-rules>
